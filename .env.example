# ---- Modele du fichier .env ----
#
# Au premier demarrage, demarrer-plateforme.ps1 cree .env a partir de ce modele
# et remplit lui-meme les six valeurs obligatoires avec des secrets aleatoires.
# Un poste neuf n'a donc rien a saisir a la main ; remplacez-les ensuite si vous
# disposez de vos propres identifiants.
#
# NE JAMAIS COMMITTER le fichier .env

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=

# Base de donnees visee par le backend.
# A laisser commente dans le cas courant : le script cherche pim_db sur le port
# 5432 (PostgreSQL natif) puis sur 5433 (celui de Docker Compose) et retient
# celui qui heberge reellement la base. Se tromper de port donne un backend qui
# demarre sur un catalogue vide. Ne renseigner cette ligne que pour imposer une
# base precise.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pim_db

# MinIO (S3)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# JWT (minimum 32 caracteres, aleatoire)
JWT_SECRET=

# Chiffrement at-rest (AES-256-GCM, minimum 32 caracteres)
PIM_ENCRYPTION_KEY=

# Double authentification obligatoire pour les comptes administrateurs.
# Passer a false uniquement sur un poste depourvu d'application d'authentification.
# PIM_MFA_REQUIRE_FOR_ADMIN=true

# ClamAV antivirus
# PIM_CLAMAV_ENABLED=true
# PIM_CLAMAV_HOST=clamav
# PIM_CLAMAV_PORT=3310

# Grafana
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# OAuth2/OIDC (Keycloak, Azure AD, etc.)
# PIM_OAUTH2_ENABLED=true
# PIM_OAUTH2_ISSUER_URI=https://keycloak.example.com/realms/moov-africa
# PIM_OAUTH2_CLIENT_ID=pim-backend

# WebAuthn / Passkeys (FIDO2)
# PIM_WEBAUTHN_ENABLED=true
# PIM_WEBAUTHN_RP_ID=your-domain.com
# PIM_WEBAUTHN_RP_NAME=Moov Africa PIM
# PIM_WEBAUTHN_ORIGIN=https://your-domain.com

# HashiCorp Vault (KMS — gestion des cles de chiffrement)
# PIM_VAULT_ENABLED=true
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=
# VAULT_DEV_TOKEN=dev-only-token

# DLP (Data Loss Prevention)
# PIM_DLP_ENABLED=true
# PIM_DLP_MAX_RESPONSE_BYTES=5242880
# PIM_DLP_MAX_REQUESTS_PER_MINUTE=200

# Overrides optionnels
# PIM_CORS_ORIGINS=https://your-domain.com
# PIM_MINIO_ENDPOINT=https://minio.your-domain.com
# PIM_SWAGGER_ENABLED=false
# SERVER_SSL_ENABLED=true
# SERVER_SSL_KEY_STORE=/path/to/keystore.p12
# SERVER_SSL_KEY_STORE_PASSWORD=
